<!DOCTYPE html>
<html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Contact Page</title>
  <%= stylesheet_link_tag 'application', media: 'all' %>
</head>
<body>
  <div class="home-banner">
    <%= image_tag 'home.png', alt: 'Home Image', class: 'home-image img-fluid w-100' %>
  </div>
  <!-- Contact Information -->
 <div class="container my-5 plats-lunch-container text-center">
    <div class="plats-lunch-text">
      <div class="row justify-content-center">
          <h1 class="lunch-week-title">Voici une selection parmi nos plats signatures</h1>
            <ul class="plat-lunch-title">Salade de Poulpe</ul>
              <p class="plat-lunch-description">Poulpe cuit à basse temperature, poivrons grillés, tomates sechées, caviar d'aubergines, roquette, parmesan</p>
            <ul class="plat-lunch-title">Ceviche de Noix Saint Jacques</ul>
              <p class="plat-lunch-description">Lait de coco & citron vert, tagliatelles de courgettes, mangue, concombre, coriandre</p>
            <ul class="plat-lunch-title">Gravlax</ul>
              <p class="plat-lunch-description">Saumon ou Truite mariné à l'aneth, Gin, salade de lentilles corail, crème au citron, basilic</p>
            <ul class="plat-lunch-title">Tataki de Thon</ul>
              <p class="plat-lunch-description">Wakamee, Houmous aux herbes d'Asie, pousses de soja, Wasabi</p>
            <ul class="plat-lunch-title">Carpaccio de Canard</ul>
              <p class="plat-lunch-description">Maki de riz, carottes marinés, cacahuètes, soja, coriandre</p>
            <ul class="plat-lunch-title">Tartare de Boeuf à la thai</ul>
              <p class="plat-lunch-description"> Citronnelle, gingembre, poivrons grillés, thai basilic, sauce Sriracha</p>
                <p> * * * </p>
          <h3>Desserts & Gâteaux</h3>
            <ul class="plat-lunch-title">Toujours la banane</ul>
              <p class="plat-lunch-description">Cake à la banane, beurre de cacahuètes, élats de chocolat noir, sans sucres ajoutés</p>
            <ul class="plat-lunch-title">Coco loco</ul>
              <p class="plat-lunch-description">Tarte à la noix de coco, citron vert, gingembre</p>
            <ul class="plat-lunch-title">Mokka</ul>
              <p class="plat-lunch-description">Tarte au chocolat noir 70%, café, amande</p>
            <ul class="plat-lunch-title">Omas Kaesekuchen</ul>
              <p class="plat-lunch-description">Cheesecake allemand légèrement citronné, vanille, raisins secs</p>
            <ul class="plat-lunch-title">Nuage rose et vert</ul>
              <p class="plat-lunch-description">Spongecake japonais au thé vert matcha, framboises</p>
                <p> * * * </p>
                  <p>Demandez nous pour decouvrir pleines d'autres de nos créations salés & sucrés! </p>
      </div>
    </div>
  </div>

  <%= javascript_include_tag 'application' %>
</body>
</html>
