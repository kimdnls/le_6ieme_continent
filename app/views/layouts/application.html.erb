<!DOCTYPE html>
<html lang="fr">
<head>
  <title>Le 6ieme Continent</title>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- FontAwesome pour les icônes -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

  <!-- Bootstrap CSS 5.3.3 -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

  <!-- Google Fonts -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@100;200;300;400;500;600;700&display=swap">

  <!-- Lightbox CSS -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/lightbox2/2.11.3/css/lightbox.min.css" rel="stylesheet">

  <!-- Rails CSRF et CSP Meta Tags -->
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <!-- Fichier CSS principal -->
  <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>

  <!-- Fichier JS principal -->
  <%= javascript_tag 'application', 'data-turbolinks-track': 'reload' %>

  <style>
    /* Style général du corps */
    body {
      background-color: #111; /* Fond sombre */
      font-family: 'Poppins', sans-serif; /* Police élégante */
      color: #eee; /* Couleur du texte claire */
      padding-top: 180px; /* Ajustez la valeur pour laisser suffisamment d'espace pour les bannières */
    }

    /* Style de la bannière blanche en haut */
    .top-banner {
      z-index: 1001;
      height: 40px;
      padding: 0 10px;
      display: flex;
      align-items: center;
      justify-content: flex-end;
    }

    /* Bannière noire collante */
    .banner_sticky {
      background-color: black;
      background-image: linear-gradient(180deg, rgba(0, 0, 0, .96) 0, rgba(0, 0, 0, .4) 100%);
      position: fixed;
      top: 20px;
      left: 0;
      z-index: 1000;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding-top: 20px;
      background-size: cover;
      background-position: center center;
      background-repeat: no-repeat;
      width: 100%;
    }

    .top-banner, .banner_sticky {
      margin: 0;
    }

     /* Style des icônes sociales */
    .social-icons {
      padding-right: 20px;
      color: #999;
      font-size: 1em;
    }

    .fa-brands, .fab {
      font-family: "Font Awesome 6 Brands";
      font-weight: 700;
      padding-right: 10px;
    }

    .fa-instagram {
      padding-right: 50px;
    }

    .top-banner .social-icons {
      /* display: flex; Aligne les icônes sur une ligne */
      gap: 10px; /* Espacement entre les icônes */
    }
    .social-icons a:hover {
      color: #EEEEEE;
    }

       /* Style du logo */
    .logo-container {
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .logo {
      max-width: 160px;
      height: auto;
      padding-top: 5px;
      padding-bottom: 0;
      margin: 0;
    }

    /* Contenu général */
    .content {
      text-align: center;
    }

    /* Style des titres */
    h1, h2, h3 {
      color: white;
    }

    /* Style des paragraphes */
    p {
      color: #bbb;
      font-size: 1.2em;
      line-height: 1.6;
      margin-bottom: 20px;
    }

    /* Centrage de l'icône du menu */
    .navbar-toggler {
      margin: 0;
      padding: 0;
      display: flex;
      justify-content: center;
      outline: none;/* Pour éviter tout autre box-shadow qui pourrait être appliqué */
      box-shadow: none;
    }

    .navbar-toggler:focus {
      outline: none;
      box-shadow: none;
    }


  .navbar-toggler-icon:focus {
    outline: none;
    box-shadow: none;
  }


    /* Ajustement des rubriques dans le menu */
    .navbar-collapse {
      text-align: left;
    }

    .navbar-nav {
      display: flex;
      flex-direction: row; /* Menu en ligne */
      align-items: center;
      width: auto; /* Chaque rubrique prend sa propre taille */
      padding-top: 0px;
      padding-bottom: 8px;
    }

    .nav-link.invisible-button {
      font-weight: 200;
      font-family: 'Poppins', sans-serif;
      color: white !important;
      text-decoration: none;
      cursor: pointer;
      font-size: 14px !important;
      padding: 0px 0px;
    }

    .nav-link.invisible-button:hover {
      color: rgb(88, 88, 104) !important;
      transition-duration: 0.4s;
      transition-timing-function: ease-in-out;
    }


    /* Style pour les petits écrans */
    @media (max-width: 767px) {
      .navbar-nav {
        flex-direction: column !important;
        align-items: center;
        width: 100%;
      }

      .nav-item {
        margin-bottom: 15px;
        width: 100%;
      }

      .nav-link {
        text-align: center;
        flex-direction: column;
        width: 100%;
      }

      .top-banner {
        height: auto;
        padding: 5px 0;
      }

      .social-icons {
        font-size: 14px;
        padding: 8px;
      }

      .banner_sticky {
        padding-top: 35px;
      }

      .logo {
        max-width: 80px;
        height: auto;
      }

      .navbar-toggler {
        margin: 0 auto;
      }

      .navbar-toggler:focus {
        outline: none;
        box-shadow: none;
      }


      .navbar-collapse {
        text-align: center;
      }
    }

    /* Style pour les écrans larges */
    @media (min-width: 768px) {
      .top-banner {
        padding: 10px 0;
      }

      .logo-container {
        margin-bottom: 20px;
      }

      .navbar-nav .nav-item {
        margin-left: 30px;
      }

      .navbar-nav .nav-link {
        color: #eee !important;
        font-size: 1.2em;
      }

      .navbar-nav .nav-link:hover {
        color: #ddd !important;
      }
    }

  </style>
</head>

<body>

  <!-- Bannière blanche -->
  <div class="container-fluid bg-white border-bottom fixed-top top-banner">
    <div class="row">
      <div class="col text-right py-1">
        <a href="https://www.facebook.com/le6iemecontinent" target="_blank" class="social-icons">
          <i class="fab fa-facebook-f"></i>
        </a>
        <a href="https://www.instagram.com/le_6ieme_continent?igsh=dHJpNGdhd3B6aXdo" target="_blank" class="social-icons">
          <i class="fab fa-instagram"></i>
        </a>
      </div>
    </div>
  </div>

  <!-- Bannière noire avec logo centré -->
  <div class="banner_sticky">
    <div class="logo-container">
      <a href="<%= root_path %>">
        <%= image_tag 'logo.jpg', alt: 'Logo', class: 'logo' %>
      </a>
    </div>

    <nav class="navbar navbar-expand-lg navbar-dark bg-black w-100">
      <div class="container-fluid">
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse justify-content-center" id="navbarNav">
          <ul class="navbar-nav">
            <li class="nav-item">
              <%= link_to "Lunch", lunch_path, class: "nav-link invisible-button" %>
            </li>
            <li class="nav-item">
              <%= link_to "Événements", evenements_path, class: "nav-link invisible-button" %>
            </li>
            <li class="nav-item">
              <%= link_to "Plats Signatures", plats_path, class: "nav-link invisible-button" %>
            </li>
            <li class="nav-item">
              <%= link_to "Photos", photos_path, class: "nav-link invisible-button" %>
            </li>
            <li class="nav-item">
              <%= link_to "Contact", contact_path, class: "nav-link invisible-button" %>
            </li>
          </ul>
        </div>
      </div>
    </nav>
  </div>

  <!-- Contenu principal -->
  <div class="content">
    <%= yield %>
  </div>

  <footer style="background-color: #111; color: #fff; padding: 20px 0; font-family: Arial, sans-serif;">
  <div style="max-width: 1200px; margin: 0 auto; display: flex; flex-wrap: wrap; justify-content: space-between; padding: 0 20px;">
    <!-- Logo and Contact Information -->
    <div style="flex: 1 1 300px; margin-bottom: 20px;">
    <p>le6iemecontninent.fr - Gastronomade</p>
    <p>Montpellier<br>Hérault</p>
    <p>Email : <a href="mailto:le6iemecontinent@gmail.com" style="color: #fff; text-decoration: none;">le6iemecontinent@gmail.com</a></p>
    <p>Téléphone : <a href="tel:+33612601245" style="color: #fff; text-decoration: none;">06 12 60 12 45</a></p>
  </div>

    <!-- Navigation Links -->
    <div style="flex: 1 1 300px; margin-bottom: 20px;">
      <ul style="list-style: none; padding: 0;">
        <li><a href="#" style="color: #fff; text-decoration: none;">LUNCH</a></li>
        <li><a href="#" style="color: #fff; text-decoration: none;">ÉVÉNEMENTS</a></li>
        <li><a href="#" style="color: #fff; text-decoration: none;">PLATS SIGNATURES</a></li>
        <li><a href="#" style="color: #fff; text-decoration: none;">PHOTOS</a></li>
        <li><a href="#" style="color: #fff; text-decoration: none;">CONTACT</a></li>
      </ul>
    </div>

    <!-- Social Media Links -->
    <div style="flex: 1 1 300px; margin-bottom: 20px;">
      <h4 style="margin-bottom: 15px;">Suivez-nous</h4>
      <div style="display: flex; gap: 10px;">
        <a href="https://www.facebook.com/le6iemecontinent" target="_blank" style="color: #fff; text-decoration: none;">
          <i class="fab fa-facebook-f"alt="Facebook" style="width: 30px;"></i>
        </a>
        <a href="https://www.instagram.com/le_6ieme_continent?igsh=dHJpNGdhd3B6aXdo" target="_blank" style="color: #fff; text-decoration: none;">
          <i class="fab fa-instagram" alt="Instagram" style="width: 30px;"></i>
        </a>
      </div>
    </div>
  </div>

  <!-- Copyright -->
  <div style="text-align: center; padding: 15px 20px; border-top: 1px solid #333;">
    <p style="margin: 0; font-size: 14px;">&copy; 2025, Le 6ième Continent - Gastronomade | Tous droits réservés – <a href="#" style="color: #fff; text-decoration: underline;">Mentions légales</a></p>
  </div>
</footer>


  <!-- Bootstrap JS Bundle avec Popper -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <!-- Lightbox JS -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/lightbox2/2.11.3/js/lightbox.min.js"></script>
</body>
</html>
