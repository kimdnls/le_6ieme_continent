<!DOCTYPE html>
<html lang="fr">
<head>
  <title>Le 6ieme Continent</title>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- FontAwesome pour les icônes -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

  <!-- Bootstrap CSS 5.3.3 -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

  <!-- Google Fonts -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@100;200;300;400;500;600;700&display=swap">

  <!-- Lightbox CSS -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/lightbox2/2.11.3/css/lightbox.min.css" rel="stylesheet">

  <!-- Rails CSRF et CSP Meta Tags -->
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <!-- Fichier CSS principal -->
  <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>

  <!-- Fichier JS principal -->
  <%= javascript_tag 'application', 'data-turbolinks-track': 'reload' %>

  <style>
    /* Style général du corps */
    body {
      background-color: #111; /* Fond sombre */
      font-family: 'Poppins', sans-serif; /* Police élégante */
      color: #eee; /* Couleur du texte claire */
      padding-top: 180px; /* Ajustez la valeur pour laisser suffisamment d'espace pour les bannières */
    }

    .banner_sticky {
      background-color: black;
      background-image: linear-gradient(180deg, rgba(0, 0, 0, .96) 0, rgba(0, 0, 0, .4) 100%);
      position: fixed;
      left: 0;
      z-index: 1000;
      display: flex;
      flex-direction: column;
      align-items: center;
      background-size: cover;
      background-position: center center;
      background-repeat: no-repeat;
      width: 100%;
      margin: 0;
    }

     /* Style des icônes sociales */
    .social-icons {
      padding-right: 20px;
      color: #999;
      font-size: 1em;
    }

    .fa-brands, .fab {
      font-family: "Font Awesome 6 Brands";
      font-weight: 700;
      padding-right: 10px;
    }

    .fa-instagram {
      padding-right: 50px;
    }

    .top-banner .social-icons {
      /* display: flex; Aligne les icônes sur une ligne */
      gap: 10px; /* Espacement entre les icônes */
    }
    .social-icons a:hover {
      color: #EEEEEE;
    }

       /* Style du logo */
    .logo-container {
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .logo {
      max-width: 160px;
      height: auto;
      padding-top: 5px;
      padding-bottom: 0;
      margin: 0;
    }

    /* Contenu général */
    .content {
      text-align: center;
    }

    /* Style des titres */
    h1, h2, h3 {
      color: white;
    }

    /* Style des paragraphes */
    p {
      color: #bbb;
      font-size: 1.2em;
      line-height: 1.6;
      margin-bottom: 20px;
    }

    /* Centrage de l'icône du menu */
    .navbar-toggler {
      margin: 0;
      padding: 0;
      display: flex;
      justify-content: center;
      outline: none;/* Pour éviter tout autre box-shadow qui pourrait être appliqué */
      box-shadow: none;
    }

    .navbar-toggler:focus {
      outline: none;
      box-shadow: none;
    }

    .navbar-toggler-icon:focus {
      outline: none;
      box-shadow: none;
    }

    /* Ajustement des rubriques dans le menu */
    .navbar-collapse {
      text-align: left;
    }

    .navbar-nav {
      display: flex;
      flex-direction: row; /* Menu en ligne */
      align-items: center;
      width: auto; /* Chaque rubrique prend sa propre taille */
      padding-top: 0px;
      padding-bottom: 8px;
    }

    .nav-link.invisible-button {
      font-weight: 200;
      font-family: 'Poppins', sans-serif;
      color: white !important;
      text-decoration: none;
      cursor: pointer;
      font-size: 14px !important;
      padding: 0px 0px;
    }

    .nav-link.invisible-button:hover {
      color: rgb(88, 88, 104) !important;
      transition-duration: 0.4s;
      transition-timing-function: ease-in-out;
    }

    footer {
      width: 100%; /* Pleine largeur */
      background-color: #000; /* Couleur de fond */
      color: #fff; /* Texte en blanc */
      padding: 10px 20px; /* Ajustement de la hauteur */
      display: flex;
      flex-wrap: wrap;
      justify-content: center; /* Centrer horizontalement */
      align-items: flex-start; /* Alignement vertical des sections */
      box-sizing: border-box;
    }

    footer .section {
      flex: 1 1 calc(33.333% - 40px); /* Colonnes égales, avec marge */
      margin: 0 20px; /* Espacement horizontal des sections */
      text-align: center; /* Centre le texte dans chaque section */
    }

    footer .section h3 {
      font-size: 1rem;
      margin-bottom: 5px;
    }

    footer .section p,
    footer .section a {
      font-size: 0.9rem;
      line-height: 1.4;
      text-decoration: none;
      color: #fff;
    }

    footer .nav-item {
      list-style: none; /* Supprime les bullet points */
    }

    footer .nav-link {
      display: block; /* Meilleure gestion des liens */
      margin-bottom: 5px; /* Espacement entre les liens */
      color: #fff;
      text-decoration: none;
      transition: color 0.3s;
    }

    footer .nav-link:hover {
      color: #f0a500; /* Couleur au survol */
    }

    footer .legal {
      width: 100%;
      text-align: center; /* Centrer le texte de la partie légale */
      font-size: 0.8rem;
      margin-top: 10px;
      border-top: 1px solid #333;
      padding-top: 10px;
    }

    /* Style pour les petits écrans */
    @media (max-width: 767px) {
      .navbar-nav {
        flex-direction: column !important;
        align-items: center;
        width: 100%;
      }

      .nav-item {
        margin-bottom: 15px;
        width: 100%;
      }

      .nav-link {
        text-align: center;
        flex-direction: column;
        width: 100%;
      }

      .top-banner {
        height: auto;
        padding: 5px 0;
      }

      .social-icons {
        font-size: 14px;
        padding: 8px;
      }

      .banner_sticky {
        padding-top: 35px;
      }

      .logo {
        max-width: 80px;
        height: auto;
      }

      .navbar-toggler {
        margin: 0 auto;
      }

      .navbar-toggler:focus {
        outline: none;
        box-shadow: none;
      }


      .navbar-collapse {
        text-align: center;
      }
    }

    /* Style pour les écrans larges */
    @media (min-width: 768px) {
      .top-banner {
        padding: 10px 0;
      }

      .logo-container {
        margin-bottom: 20px;
      }

      .navbar-nav .nav-item {
        margin-left: 30px;
      }

      .navbar-nav .nav-link {
        color: #eee !important;
        font-size: 1.2em;
      }

      .navbar-nav .nav-link:hover {
        color: #ddd !important;
      }
    }
  </style>
</head>

<body>

  <!-- Bannière noire avec logo centré -->
  <div class="banner_sticky">
    <div class="logo-container">
      <a href="<%= root_path %>">
        <%= image_tag 'logo.jpg', alt: 'Logo', class: 'logo' %>
      </a>
    </div>

    <nav class="navbar navbar-expand-lg navbar-dark bg-black w-100">
      <div class="container-fluid">
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse justify-content-center" id="navbarNav">
          <ul class="navbar-nav">
            <li class="nav-item">
              <%= link_to "Lunch", lunch_path, class: "nav-link invisible-button" %>
            </li>
            <li class="nav-item">
              <%= link_to "Événements", evenements_path, class: "nav-link invisible-button" %>
            </li>
            <li class="nav-item">
              <%= link_to "Plats Signatures", plats_path, class: "nav-link invisible-button" %>
            </li>
            <li class="nav-item">
              <%= link_to "Photos", photos_path, class: "nav-link invisible-button" %>
            </li>
            <li class="nav-item">
              <%= link_to "Contact", contact_path, class: "nav-link invisible-button" %>
            </li>
          </ul>
        </div>
      </div>
    </nav>
  </div>

  <!-- Contenu principal -->
  <div class="content">
    <%= yield %>
  </div>

<footer>
  <div class="section">
    <p>Le 6ième Continent</p>
    <p>Montpellier & Région - Gastronomade</p>
    <p>Email : <a href="mailto:le6iemecontinent@gmail.com">le6iemecontinent@gmail.com</a></p>
    <p>Téléphone : 06 12 60 12 45</p>
  </div>

<div class="section">
  <ul class="ul-nav">
    <li class="nav-item">
      <%= link_to "Lunch", lunch_path, class: "nav-link invisible-button" %>
    </li>
    <li class="nav-item">
      <%= link_to "Événements", evenements_path, class: "nav-link invisible-button" %>
    </li>
    <li class="nav-item">
      <%= link_to "Plats Signatures", plats_path, class: "nav-link invisible-button" %>
    </li>
    <li class="nav-item">
      <%= link_to "Photos", photos_path, class: "nav-link invisible-button" %>
    </li>
    <li class="nav-item">
      <%= link_to "Contact", contact_path, class: "nav-link invisible-button" %>
    </li>
  </ul>
</div>

  <div class="section">
    <h3>Suivez-nous</h3>
    <div class="social-icons">
      <a href="https://www.facebook.com/le6iemecontinent" aria-label="Facebook"><i class="fab fa-facebook"></i></a>
      <a href="https://www.instagram.com/le_6ieme_continent?igsh=dHJpNGdhd3B6aXdo" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
    </div>
  </div>

  <div class="legal">
    &copy; 2025, Le 6ième Continent - Gastronomade | Tous droits réservés – <a href="#">Mentions légales</a>
  </div>
</footer>


  <!-- Bootstrap JS Bundle avec Popper -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <!-- Lightbox JS -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/lightbox2/2.11.3/js/lightbox.min.js"></script>
</body>
</html>
