<!DOCTYPE html>
<html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Evenements</title>
  <%= stylesheet_link_tag 'application', media: 'all' %>
  <style>
    /* Suppression des puces */
    .text-content ul {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    /* Ajustement du texte */
    .text-content {
      padding: 20px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      height: 100%; /* S'assure que le texte occupe tout l'espace disponible */
    }

    /* Pour éviter les coupures */
    .event-container {
      display: flex;
      flex-wrap: wrap; /* Permet de gérer les petits écrans */
      gap: 20px; /* Espace entre texte et image */
    }

    /* Bouton bien visible */
    .image-content .btn {
      display: inline-block;
      margin-top: 20px;
      padding: 10px 20px;
      background-color: #f7931e; /* Couleur du bouton */
      color: white;
      text-decoration: none;
      border-radius: 5px;
      font-size: 16px;
    }

    .image-content .btn:hover {
      background-color: #e5821b; /* Légère variation au survol */
    }

    /* Ajustement des images */
    .contact-image {
      max-width: 100%;
      height: auto;
    }

    /* Centrage des sections */
    .image-content {
      text-align: center;
    }
  </style>
</head>
<body>
  <!-- Event Banner -->
  <div class="event-banner">
    <%= image_tag 'eventbeach.jpg', alt: 'Event Image', class: 'event-image img-fluid w-100' %>
  </div>

  <!-- Information -->
  <div class="container my-5 lunch-container text-center">
    <div class="row justify-content-center">
      <div class="col-12">
        <h1 class="lunch-title">NOTRE SPECIALITE</h1>
        <p>Vous offrir un voyage culinaire</p>
        <p>pour rendre votre événement unique</p>
        <h2 class="orange">DECOUVRIR * SAVOURER * PARTAGER</h2>
      </div>
    </div>
  </div>

  <!-- Event Details -->
  <div class="container my-5 event-container">
    <div class="col-12 col-lg-6 text-content">
      <ul>
        <li>Laissez-vous séduire par nos savoureuses créations.</li>
        <li>Des envies de sur-mesure ?</li>
        <li>Nous vous proposons des saveurs 100% personnalisées.</li>
        <li>Nous personnalisons l’ensemble de nos services pour vous offrir un moment d’exception.</li>
        <li>Nous rendons votre événement inoubliable, avec la possibilité de cuisine à la minute devant vos invités.</li>
        <li>Contactez-nous pour en savoir plus!</li>
      </ul>
    </div>

    <div class="col-12 col-lg-6 text-center image-content">
      <%= image_tag 'octopus.jpg', alt: 'TopChef Image', class: 'contact-image img-fluid rounded' %>
      <!-- Bouton d'appel à l'action -->
      <a href="<%= contact_path %>" class="btn">Demandez un devis</a>
    </div>
  </div>

  <!-- Footer -->
  <div class="followcontent text-center py-4">
    <p>CHEF A DOMICILE</p>
    <p>*</p>
    <p>EVENEMENTS D'ENTREPRISES</p>
    <p>*</p>
    <p>MARIAGES ET LENDEMAINS DE MARIAGES</p>
    <p>*</p>
    <p>SOIREES PRIVEES & MORE</p>
    <p>*</p>
  </div>

  <%= javascript_include_tag 'application' %>
</body>
</html>
